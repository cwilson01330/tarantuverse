# Mobile app .easignore
# Exclude sibling apps from the build
../../apps/web/
../../apps/api/

# Exclude packages we don't need
../../packages/

# Exclude config/docs we don't need
../../.claude/
../../.vercel/
../../.github/
../../scripts/
../../docs/

# Git
../../.git/

# Build outputs
../../.turbo/
../../dist/
../../build/
../../.next/

# Test files
../../**/__tests__/
../../**/__mocks__/
../../**/*.test.*
../../**/*.spec.*

# Docs
../../*.md
!../../apps/mobile/README.md

# Python tooling caches. Metro walks the monorepo root and hits an EPERM on
# .pytest_cache on Windows, logging a scary-looking error on every build. It's
# harmless (the directory is skipped) but it's noise that hides real warnings.
../../.pytest_cache/
../../**/.pytest_cache/
../../**/__pycache__/
../../**/*.pyc
../../.ruff_cache/
